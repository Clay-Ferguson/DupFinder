# Template only. packaging/build-deb.sh rewrites Exec= and Icon= for where it is
# installing to, so the paths below are never used.
[Desktop Entry]
Name=DupFinder
Comment=Find duplicate files under a folder
Exec=/path/to/DupFinder/start.sh
Icon=dupfinder
Terminal=false
Type=Application
Categories=Utility;
StartupWMClass=dupfinder
